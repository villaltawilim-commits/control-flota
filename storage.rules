rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /photos/{fuelLogId}/{fileName} {
      // Fine-grained "does this user have fuel.create/delete" is already
      // enforced by Firestore rules on the fuelLogs document these photos
      // belong to; Storage only needs to confirm the caller is a signed-in
      // account of ours (cross-service firestore.get() here proved unreliable).
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null;
    }
  }
}
